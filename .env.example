# Django Settings
SECRET_KEY='your-super-secret-key-change-this-in-production'
DEBUG=False
ALLOWED_HOSTS='yourdomain.render.com,www.yourdomain.com,localhost,127.0.0.1'
CSRF_TRUSTED_ORIGINS='https://yourdomain.render.com,https://www.yourdomain.com'

# Database Configuration
# For Render.com PostgreSQL, use the DATABASE_URL from Render dashboard
DATABASE_URL='postgresql://user:password@host:5432/dbname'

# Email Configuration (Gmail, SendGrid, or other SMTP provider)
EMAIL_BACKEND='django.core.mail.backends.smtp.EmailBackend'
EMAIL_HOST='smtp.gmail.com'
EMAIL_PORT='587'
EMAIL_HOST_USER='your_email@gmail.com'
EMAIL_HOST_PASSWORD='your_app_password'
EMAIL_USE_TLS='True'
EMAIL_USE_SSL='False'
DEFAULT_FROM_EMAIL='noreply@yourdomain.com'
SITE_URL='https://yourdomain.render.com'

# OAuth Credentials (Google)
GOOGLE_CLIENT_ID='your-google-client-id'
GOOGLE_CLIENT_SECRET='your-google-client-secret'

# OAuth Credentials (GitHub)
GITHUB_CLIENT_ID='your-github-client-id'
GITHUB_CLIENT_SECRET='your-github-client-secret'

# Payment Gateway - Paystack
PAYSTACK_PUBLIC_KEY='pk_live_your_paystack_public_key'
PAYSTACK_SECRET_KEY='sk_live_your_paystack_secret_key'

# AI Integration - Groq
GROQ_API_KEY='your-groq-api-key'

# Push Notifications (Web Push)
VAPID_PUBLIC_KEY='your-vapid-public-key'
VAPID_PRIVATE_KEY='your-vapid-private-key'